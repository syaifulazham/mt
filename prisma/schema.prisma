  @@index([walkInJudgingEndpointId])
  @@map("walkin_judging_scores")
}

model WalkInRegistration {
  id                  String       @id @default(cuid())
  walkInCompetitionId String
  participantId       String
  contingentId        String
  status              WalkInStatus @default(PENDING)
  method              WalkInMethod @default(PORTAL)
