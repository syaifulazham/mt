generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─────────────────────────────────────────────────────────────────────────────
// ORGANIZER AUTH (Auth.js v5)
// ─────────────────────────────────────────────────────────────────────────────

model OrganizerUser {
  id                  String        @id @default(cuid())
  email               String        @unique
  name                String
  passwordHash        String
  role                OrganizerRole @default(VIEWER)
  totpSecretEnc       String?
  totpEnabled         Boolean       @default(false)
  forcePasswordChange Boolean       @default(false)
  isActive            Boolean       @default(true)
  inviteToken         String?       @unique
  inviteExpiresAt     DateTime?
  lastLoginAt         DateTime?
  createdById         String?
  createdAt           DateTime      @default(now())
  updatedAt           DateTime      @updatedAt
  deletedAt           DateTime?

  sessions    OrganizerSession[]
  accounts    OrganizerAccount[]
  emailBlasts EmailBlast[]

  @@map("organizer_users")
}

model OrganizerSession {
  id           String        @id @default(cuid())
  sessionToken String        @unique
  userId       String
  expires      DateTime
  user         OrganizerUser @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("organizer_sessions")
}

model OrganizerAccount {
  id                String        @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  user              OrganizerUser @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@map("organizer_accounts")
}

enum OrganizerRole {
  SUPER_ADMIN
  ADMIN
  OPERATOR
  PARTICIPANTS_MANAGER
  JUDGE_COORDINATOR
  VIEWER
}

// ─────────────────────────────────────────────────────────────────────────────
// MANAGER AUTH (Clerk-managed, synced via webhook)
// ─────────────────────────────────────────────────────────────────────────────

model ManagerProfile {
  id                  String          @id @default(cuid())
  clerkUserId         String          @unique
  email               String          @unique
  name                String
  phone               String?
  idType              IdType?
  idNumber            String?
  nationality         String?
  address             String?
  institutionType     InstitutionType?
  schoolId            String?
  higherInstitutionId String?
  countryId           String?
  profileComplete     Boolean         @default(false)
  lmsUserId           String?
  lmsPassword         String?
  createdAt           DateTime        @default(now())
  updatedAt           DateTime        @updatedAt
  deletedAt           DateTime?

  school            School?            @relation(fields: [schoolId], references: [id])
  higherInstitution HigherInstitution? @relation(fields: [higherInstitutionId], references: [id])
  country           Country?           @relation(fields: [countryId], references: [id])
  contingentManagers ContingentManager[]

  @@map("manager_profiles")
}

enum IdType {
  IC
  PASSPORT
}

enum InstitutionType {
  SCHOOL
  HIGHER
  INDEPENDENT
  INTERNATIONAL
}

// ─────────────────────────────────────────────────────────────────────────────
// REFERENCE DATA — Geography
// ─────────────────────────────────────────────────────────────────────────────

model Country {
  id       String  @id @default(cuid())
  name     String
  codeIso2 String  @unique @db.Char(2)
  codeIso3 String  @unique @db.Char(3)
  isActive Boolean @default(true)

  states     State[]
  managers   ManagerProfile[]
  contingents Contingent[]

  @@map("countries")
}

model AppSetting {
  key   String @id
  value String

  @@map("app_settings")
}

model State {
  id        String  @id @default(cuid())
  name      String
  code      String  @unique
  flagUrl   String?
  countryId String

  country           Country             @relation(fields: [countryId], references: [id])
  zoneStates        ZoneState[]
  schools           School[]
  higherInstitutions HigherInstitution[]
  contingents       Contingent[]
  events            Event[]

  @@map("states")
}

model Zone {
  id   String @id @default(cuid())
  name String

  states      ZoneState[]
  districts   District[]
  schools     School[]
  contingents Contingent[]
  events      Event[]

  @@map("zones")
}

model ZoneState {
  zoneId  String
  stateId String

  zone  Zone  @relation(fields: [zoneId],  references: [id], onDelete: Cascade)
  state State @relation(fields: [stateId], references: [id], onDelete: Cascade)

  @@id([zoneId, stateId])
  @@map("zone_states")
}

model District {
  id     String @id @default(cuid())
  name   String
  zoneId String

  zone    Zone     @relation(fields: [zoneId], references: [id])
  schools School[]

  @@map("districts")
}

// ─────────────────────────────────────────────────────────────────────────────
// REFERENCE DATA — Institutions
// ─────────────────────────────────────────────────────────────────────────────

model School {
  id            String         @id @default(cuid())
  name          String
  code          String         @unique
  ppdCode       String?
  stateId       String
  zoneId        String?
  districtId    String?
  level         SchoolLevel
  category      SchoolCategory
  categoryShort String?
  isActive      Boolean        @default(true)
  latitude      Float?
  longitude     Float?

  state      State     @relation(fields: [stateId], references: [id])
  zone       Zone?     @relation(fields: [zoneId], references: [id])
  district   District? @relation(fields: [districtId], references: [id])
  contingents Contingent[]
  managers   ManagerProfile[]

  @@map("schools")
}

model HigherInstitution {
  id         String  @id @default(cuid())
  name       String
  code       String? @unique
  stateId    String?
  isActive   Boolean @default(true)
  heiType    String  @default("HQ")   // HQ or BRANCH
  parentCode String?                   // for BRANCH: code of the parent HQ
  sector     String?                   // PUBLIC, PRIVATE, FOREIGN_BRANCH

  state       State?          @relation(fields: [stateId], references: [id])
  contingents Contingent[]
  managers    ManagerProfile[]

  @@map("higher_institutions")
}

enum SchoolLevel {
  PRIMARY
  SECONDARY
  SPECIAL
}

enum SchoolCategory {
  // ── Public national schools ───────────────────────────────────────────────
  SEKOLAH_KEBANGSAAN                     @map("Sekolah Kebangsaan")
  SEKOLAH_MENENGAH_KEBANGSAAN            @map("Sekolah Menengah Kebangsaan")
  SEKOLAH_JENIS_KEBANGSAAN_CINA          @map("Sekolah Jenis Kebangsaan Cina")
  SEKOLAH_JENIS_KEBANGSAAN_TAMIL         @map("Sekolah Jenis Kebangsaan Tamil")

  // ── Religious schools ─────────────────────────────────────────────────────
  SEKOLAH_MENENGAH_KEBANGSAAN_AGAMA      @map("Sekolah Menengah Kebangsaan Agama")
  SEKOLAH_MENENGAH_AGAMA_BANTUAN_KERAJAAN @map("Sekolah Menengah Agama Bantuan Kerajaan")
  SEKOLAH_RENDAH_AGAMA_BANTUAN_KERAJAAN  @map("Sekolah Rendah Agama Bantuan Kerajaan")
  SEKOLAH_MENENGAH_AGAMA                 @map("Sekolah Menengah Agama")
  SEKOLAH_RENDAH_AGAMA                   @map("Sekolah Rendah Agama")
  SEKOLAH_KEBANGSAAN_TAHFIZ              @map("Sekolah Kebangsaan Tahfiz")

  // ── Elite / residential ───────────────────────────────────────────────────
  SEKOLAH_BERASRAMA_PENUH                @map("Sekolah Berasrama Penuh")
  MAKTAB_RENDAH_SAINS_MARA               @map("Maktab Rendah Sains MARA")

  // ── Vocational & technical ────────────────────────────────────────────────
  KOLEJ_VOKASIONAL                       @map("Kolej Vokasional")
  SEKOLAH_MENENGAH_TEKNIK                @map("Sekolah Menengah Teknik")

  // ── Special needs ─────────────────────────────────────────────────────────
  SEKOLAH_KEBANGSAAN_PENDIDIKAN_KHAS     @map("Sekolah Kebangsaan Pendidikan Khas")
  SEKOLAH_MENENGAH_PENDIDIKAN_KHAS       @map("Sekolah Menengah Pendidikan Khas")
  SEKOLAH_BIMBINGAN_JALINAN_KASIH        @map("Sekolah Bimbingan Jalinan Kasih")
  SEKOLAH_MODEL_KHAS                     @map("Sekolah Model Khas")

  // ── Specialised public schools ────────────────────────────────────────────
  SEKOLAH_SENI_MALAYSIA                  @map("Sekolah Seni Malaysia")
  SEKOLAH_SUKAN_MALAYSIA                 @map("Sekolah Sukan Malaysia")
  PUSAT_TINGKATAN_ENAM                   @map("Pusat Tingkatan Enam")
  KOLEJ_TINGKATAN_ENAM                   @map("Kolej Tingkatan Enam")

  // ── Private & independent ─────────────────────────────────────────────────
  SEKOLAH_ANTARABANGSA                   @map("Sekolah Antarabangsa")
  SEKOLAH_MENENGAH_PERSENDIRIAN_CINA     @map("Sekolah Menengah Persendirian Cina")
  SEKOLAH_MENENGAH_AKADEMIK              @map("Sekolah Menengah Akademik")
  SEKOLAH_RENDAH_AKADEMIK                @map("Sekolah Rendah Akademik")
}

// ─────────────────────────────────────────────────────────────────────────────
// CONTINGENTS (Phase 1 — structure only, full relations in Phase 2)
// ─────────────────────────────────────────────────────────────────────────────

model Contingent {
  id                  String           @id @default(cuid())
  name                String
  shortName           String?
  logoUrl             String?
  contingentType      ContingentType
  locality            Locality?
  schoolId            String?
  higherInstitutionId String?
  countryInvitationId String?
  stateId             String?
  zoneId              String?
  countryId           String?
  status              ContingentStatus @default(ACTIVE)
  createdAt           DateTime         @default(now())
  updatedAt           DateTime         @updatedAt

  school            School?            @relation(fields: [schoolId], references: [id])
  higherInstitution HigherInstitution? @relation(fields: [higherInstitutionId], references: [id])
  state             State?             @relation(fields: [stateId], references: [id])
  zone              Zone?              @relation(fields: [zoneId], references: [id])
  country           Country?           @relation(fields: [countryId], references: [id])
  managers          ContingentManager[]
  participants      Participant[]
  teams             Team[]
  trainers          Trainer[]
  walkInRegistrations WalkInRegistration[]

  @@unique([schoolId])
  @@map("contingents")
}

model ContingentManager {
  id             String                  @id @default(cuid())
  contingentId   String
  managerId      String
  role           ContingentManagerRole   @default(MANAGER)
  status         ContingentManagerStatus @default(ACTIVE)
  requestMessage String?
  respondedAt    DateTime?
  createdAt      DateTime                @default(now())

  contingent Contingent     @relation(fields: [contingentId], references: [id], onDelete: Cascade)
  manager    ManagerProfile @relation(fields: [managerId], references: [id])

  @@unique([contingentId, managerId])
  @@map("contingent_managers")
}

enum Locality {
  BANDAR
  SUB_BANDAR
  LUAR_BANDAR
  PEDALAMAN_1
  PEDALAMAN_2
  PEDALAMAN_3
}

enum ContingentType {
  SCHOOL
  HIGHER
  INDEPENDENT
  INTERNATIONAL
}

enum ContingentStatus {
  ACTIVE
  SUSPENDED
}

enum ContingentManagerRole {
  OWNER
  MANAGER
}

enum ContingentManagerStatus {
  PENDING
  ACTIVE
  REJECTED
}

// ─────────────────────────────────────────────────────────────────────────────
// CONTESTANTS
// ─────────────────────────────────────────────────────────────────────────────

model Participant {
  id          String        @id @default(cuid())
  name        String
  ic          String?
  email       String?
  phoneNumber String?
  gender      Gender
  age         Int?
  eduLevel    EduLevel
  classGrade  String?
  className   String?
  ethnicity   Ethnicity?
  status        String        @default("ACTIVE")
  ppki          Boolean       @default(false)
  passwordHash  String?
  contingentId  String
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  contingent  Contingent    @relation(fields: [contingentId], references: [id], onDelete: Cascade)
  teamMembers      TeamMember[]
  sessions         ParticipantSession[]
  droneAccesses    DroneAccess[]
  walkInRegistrations WalkInRegistration[]

  @@index([contingentId])
  @@map("contestants")
}

model ParticipantSession {
  id            String      @id @default(cuid())
  participantId String
  token         String      @unique @default(cuid())
  expiresAt     DateTime
  createdAt     DateTime    @default(now())

  participant   Participant @relation(fields: [participantId], references: [id], onDelete: Cascade)

  @@index([participantId])
  @@map("participant_sessions")
}

enum Ethnicity {
  MELAYU
  CINA
  INDIA
  ORANG_ASLI_SEMENANJUNG
  BUMIPUTRA_SABAH
  BUMIPUTRA_SARAWAK
  LAIN_LAIN
}

enum Gender {
  MALE
  FEMALE
}

enum EduLevel {
  KINDERGARTEN
  PRIMARY
  SECONDARY
  YOUTH
}

// ─────────────────────────────────────────────────────────────────────────────
// TARGET GROUPS & THEMES
// ─────────────────────────────────────────────────────────────────────────────

model TargetGroup {
  id          String   @id @default(cuid())
  code        String   @unique
  name        String
  schoolLevel String
  ageGroup    String
  minAge      Int      @default(0)
  maxAge      Int      @default(0)
  classGrades String[] @default([])
  ppki        Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  competitions CompetitionTargetGroup[]

  @@map("target_groups")
}

model Theme {
  id          String   @id @default(cuid())
  name        String   @unique
  color       String?
  logoUrl     String?
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  competitions Competition[]

  @@map("themes")
}

// ─────────────────────────────────────────────────────────────────────────────
// EVENTS & COMPETITIONS
// ─────────────────────────────────────────────────────────────────────────────

model Event {
  id                  String      @id @default(cuid())
  name                String
  slug                String      @unique
  description         String?
  scope               EventScope  @default(NATIONAL)
  stateId             String?
  zoneId              String?
  venue               String?
  address             String?
  city                String?
  latitude            Float?
  longitude           Float?
  startDate           DateTime?
  endDate             DateTime?
  registrationStart   DateTime?
  registrationEnd     DateTime?
  status                  EventStatus @default(DRAFT)
  needManagerAcceptance   Boolean     @default(false)
  walkInUniqueParticipation Boolean   @default(false)
  createdAt               DateTime    @default(now())
  updatedAt           DateTime    @updatedAt

  state               State?              @relation(fields: [stateId], references: [id])
  zone                Zone?               @relation(fields: [zoneId], references: [id])
  prerequisites       EventPrerequisite[] @relation("EventPrerequisites")
  asPrerequisiteOf    EventPrerequisite[] @relation("EventAsPrerequisite")
  eventCompetitions   EventCompetition[]
  walkInCompetitions   EventWalkInCompetition[]
  walkInEndpoints      WalkInEndpoint[]
  walkInJudgingEndpoints WalkInJudgingEndpoint[]
  teamEvents           TeamEvent[]
  resultsEndpoints     ResultsEndpoint[]
  attendanceEndpoints  AttendanceEndpoint[]

  @@map("events")
}

model EventPrerequisite {
  eventId        String
  prerequisiteId String

  event        Event @relation("EventPrerequisites",  fields: [eventId],        references: [id], onDelete: Cascade)
  prerequisite Event @relation("EventAsPrerequisite", fields: [prerequisiteId], references: [id], onDelete: Cascade)

  @@id([eventId, prerequisiteId])
  @@map("event_prerequisites")
}

model Competition {
  id                          String              @id @default(cuid())
  code                        String              @unique
  name                        String
  description                 String?
  themeId                     String?
  participationType           ParticipationType   @default(INDIVIDUAL)
  minTeamSize                 Int                 @default(1)
  maxTeamSize                 Int                 @default(1)
  maxParticipantsPerContingent Int                @default(0)
  maxTotalParticipants        Int                 @default(0)
  venue                       String?
  address                     String?
  startDate                   DateTime?
  endDate                     DateTime?
  registrationStart           DateTime?
  registrationEnd             DateTime?
  judgingType                 JudgingType         @default(PERCENTAGE)
  eptimEduCourseId            String?
  eptimEduCourseTitle         String?
  thirdPartyIntegration       String?             @default("none")
  createdAt                   DateTime            @default(now())
  updatedAt                   DateTime            @updatedAt

  theme                Theme?                     @relation(fields: [themeId], references: [id])
  targetGroups         CompetitionTargetGroup[]
  judgingCriteria      JudgingCriteria[]
  eventCompetitions    EventCompetition[]
  walkInCompetitions   EventWalkInCompetition[]
  teams                Team[]
  docs                 CompetitionDoc[]

  @@map("competitions")
}

model CompetitionDoc {
  id            String      @id @default(cuid())
  competitionId String
  name          String
  url           String
  key           String
  size          Int?
  uploadedAt    DateTime    @default(now())

  competition Competition @relation(fields: [competitionId], references: [id], onDelete: Cascade)

  @@index([competitionId])
  @@map("competition_docs")
}

model EventCompetition {
  id            String   @id @default(cuid())
  eventId       String
  competitionId String
  picName       String?
  picContact    String?
  maxTeams            Int      @default(0)
  eptimEduCourseId    String?
  eptimEduCourseTitle String?
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  event              Event                              @relation(fields: [eventId],       references: [id], onDelete: Cascade)
  competition        Competition                        @relation(fields: [competitionId], references: [id], onDelete: Cascade)
  judgingTemplates   EventCompetitionJudgingTemplate[]
  judgingTasks       JudgingTask[]

  @@unique([eventId, competitionId])
  @@map("event_competitions")
}

model EventWalkInCompetition {
  id              String   @id @default(cuid())
  eventId         String
  competitionId   String
  picName         String?
  picContact      String?
  maxSlots        Int      @default(0)
  publishToPortal  Boolean  @default(false)
  useViblockarena    Boolean  @default(false)
  useDronearena      Boolean  @default(false)
  useVibeblocks      Boolean  @default(false)
  viblockChallengeId       String?
  vibeBlocksChallengeId    String?
  vibeBlocksEventName      String?
  vibeBlocksStartsAt       DateTime?
  vibeBlocksEndsAt         DateTime?
  vibeBlocksRunDurationSec Int?
  viblockChallengeLocked Boolean  @default(false)
  judgingTemplatesLocked Boolean  @default(false)
  walkInSlotSchedule     Json?
  createdAt              DateTime @default(now())
  updatedAt        DateTime @updatedAt

  event         Event       @relation(fields: [eventId],       references: [id], onDelete: Cascade)
  competition   Competition @relation(fields: [competitionId], references: [id])
  registrations    WalkInRegistration[]
  endpoints        WalkInEndpoint[]
  judgingTemplates EventWalkInCompetitionJudgingTemplate[]
  judgingEndpoints WalkInJudgingEndpoint[]

  @@unique([eventId, competitionId])
  @@map("event_walkin_competitions")
}

model WalkInEndpoint {
  id                  String   @id @default(cuid())
  eventId             String
  walkInCompetitionId String?  // null = general endpoint (any competition in the event)
  routeSlug           String   @unique
  passcode            String
  label               String?
  active              Boolean  @default(true)
  createdAt           DateTime @default(now())

  event             Event                   @relation(fields: [eventId],             references: [id], onDelete: Cascade)
  walkInCompetition EventWalkInCompetition? @relation(fields: [walkInCompetitionId], references: [id], onDelete: SetNull)

  @@map("walkin_endpoints")
}

enum WalkInJudgingEndpointStatus {
  ACTIVE
  CLOSED
}

model WalkInJudgingEndpoint {
  id                  String                      @id @default(cuid())
  eventId             String
  walkInCompetitionId String
  judgingTemplateId   String
  routeSlug           String                      @unique
  passcode            String
  label               String?
  status              WalkInJudgingEndpointStatus @default(ACTIVE)
  createdAt           DateTime                    @default(now())
  updatedAt           DateTime                    @updatedAt

  event             Event                  @relation(fields: [eventId],             references: [id], onDelete: Cascade)
  walkInCompetition EventWalkInCompetition @relation(fields: [walkInCompetitionId], references: [id], onDelete: Cascade)
  judgingTemplate   JudgingTemplate        @relation(fields: [judgingTemplateId],   references: [id], onDelete: Cascade)
  scores            WalkInJudgingScore[]

  @@index([walkInCompetitionId])
  @@map("walkin_judging_endpoints")
}

model WalkInJudgingScore {
  id                      String   @id @default(cuid())
  walkInJudgingEndpointId String
  walkInRegistrationId    String
  criterionId             String
  score                   Float?
  timeSeconds             Int?
  optionIds               String[]
  createdAt               DateTime @default(now())
  updatedAt               DateTime @updatedAt

  walkInJudgingEndpoint WalkInJudgingEndpoint @relation(fields: [walkInJudgingEndpointId], references: [id], onDelete: Cascade)
  walkInRegistration    WalkInRegistration    @relation(fields: [walkInRegistrationId],    references: [id], onDelete: Cascade)
  criterion             JudgingCriterion      @relation(fields: [criterionId],             references: [id], onDelete: Cascade)

  @@unique([walkInJudgingEndpointId, walkInRegistrationId, criterionId])
  @@index([walkInJudgingEndpointId])
  @@map("walkin_judging_scores")
}

model WalkInRegistration {
  id                  String       @id @default(cuid())
  walkInCompetitionId String
  participantId       String
  contingentId        String
  status              WalkInStatus @default(PENDING)
  method              WalkInMethod @default(PORTAL)
  registeredBy        String?
  confirmedAt         DateTime?
  viblockToken        String?
  sessionNumber       Int?
  slotNumber          Int?
  createdAt           DateTime     @default(now())
  updatedAt           DateTime     @updatedAt

  walkInCompetition EventWalkInCompetition @relation(fields: [walkInCompetitionId], references: [id], onDelete: Cascade)
  participant       Participant            @relation(fields: [participantId],       references: [id])
  contingent        Contingent             @relation(fields: [contingentId],        references: [id])
  judgingScores     WalkInJudgingScore[]

  @@unique([walkInCompetitionId, participantId])
  @@map("walkin_registrations")
}

enum WalkInStatus {
  PENDING
  CONFIRMED
  REJECTED
  CANCELLED
}

enum WalkInMethod {
  COUNTER
  PORTAL
}

model EventCompetitionJudgingTemplate {
  id                 String   @id @default(cuid())
  eventCompetitionId String
  judgingTemplateId  String
  createdAt          DateTime @default(now())

  eventCompetition EventCompetition @relation(fields: [eventCompetitionId], references: [id], onDelete: Cascade)
  judgingTemplate  JudgingTemplate  @relation(fields: [judgingTemplateId],  references: [id], onDelete: Cascade)

  @@unique([eventCompetitionId, judgingTemplateId])
  @@map("event_competition_judging_templates")
}

model EventWalkInCompetitionJudgingTemplate {
  id                  String   @id @default(cuid())
  walkInCompetitionId String
  judgingTemplateId   String
  createdAt           DateTime @default(now())

  walkInCompetition EventWalkInCompetition @relation(fields: [walkInCompetitionId], references: [id], onDelete: Cascade)
  judgingTemplate   JudgingTemplate        @relation(fields: [judgingTemplateId],   references: [id], onDelete: Cascade)

  @@unique([walkInCompetitionId, judgingTemplateId])
  @@map("event_walkin_competition_judging_templates")
}

model CompetitionTargetGroup {
  competitionId String
  targetGroupId String

  competition Competition @relation(fields: [competitionId], references: [id], onDelete: Cascade)
  targetGroup TargetGroup @relation(fields: [targetGroupId], references: [id], onDelete: Cascade)

  @@id([competitionId, targetGroupId])
  @@map("competition_target_groups")
}

model JudgingCriteria {
  id            String   @id @default(cuid())
  competitionId String
  name          String
  description   String?
  value         Float
  order         Int      @default(0)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  competition Competition @relation(fields: [competitionId], references: [id], onDelete: Cascade)

  @@map("judging_criteria")
}

enum EventScope {
  NATIONAL
  STATE
  ZONE
  OPEN
  ONLINE_NATIONAL
  ONLINE_STATE
  ONLINE_ZONE
  ONLINE_OPEN
}

enum EventStatus {
  DRAFT
  PUBLISHED
  ACTIVE
  COMPLETED
  CANCELLED
  ARCHIVE
}

enum ParticipationType {
  INDIVIDUAL
  TEAM
}

enum JudgingType {
  PERCENTAGE
  SCORE
}


// ─────────────────────────────────────────────────────────────────────────────
// TEAMS
// ─────────────────────────────────────────────────────────────────────────────

model Team {
  id            String   @id @default(cuid())
  name          String
  email              String?
  lmsUserId          String?
  lmsPassword        String?
  lmsCourseEnrolled  Boolean  @default(false)
  competitionId String
  contingentId  String
  status        String   @default("ACTIVE")
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  competition    Competition @relation(fields: [competitionId], references: [id])
  contingent     Contingent  @relation(fields: [contingentId], references: [id])
  members        TeamMember[]
  trainers       TeamTrainer[]
  teamEvents     TeamEvent[]
  droneAccess    TeamDroneAccess?
  judgingScores  JudgingScore[]

  @@map("teams")
}

model TeamMember {
  id            String   @id @default(cuid())
  teamId        String
  participantId String   @map("contestantId")
  createdAt     DateTime @default(now())

  team        Team        @relation(fields: [teamId], references: [id], onDelete: Cascade)
  participant Participant @relation(fields: [participantId], references: [id], onDelete: Cascade)

  @@unique([teamId, participantId])
  @@map("team_members")
}

// ─────────────────────────────────────────────────────────────────────────────
// TRAINERS
// ─────────────────────────────────────────────────────────────────────────────

model Trainer {
  id           String   @id @default(cuid())
  name         String
  ic           String?
  email        String?
  phoneNumber  String?
  contingentId String
  status       String   @default("ACTIVE")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  contingent Contingent   @relation(fields: [contingentId], references: [id], onDelete: Cascade)
  teams      TeamTrainer[]

  @@index([contingentId])
  @@map("trainers")
}

model TeamTrainer {
  id         String   @id @default(cuid())
  teamId     String
  trainerId  String
  createdAt  DateTime @default(now())

  team    Team    @relation(fields: [teamId],    references: [id], onDelete: Cascade)
  trainer Trainer @relation(fields: [trainerId], references: [id], onDelete: Cascade)

  @@unique([teamId, trainerId])
  @@map("team_trainers")
}

// ─────────────────────────────────────────────────────────────────────────────
// JUDGING TEMPLATES
// ─────────────────────────────────────────────────────────────────────────────

enum JudgingTaskStatus {
  ACTIVE
  CLOSED
}

enum CriterionType {
  NUMBER
  TIME
  SINGLE_OPTION
  MULTIPLE_OPTION
}

model JudgingTemplate {
  id          String   @id @default(cuid())
  name        String
  code        String   @unique
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  criterions           JudgingCriterion[]
  eventCompetitions    EventCompetitionJudgingTemplate[]
  walkInCompetitions   EventWalkInCompetitionJudgingTemplate[]
  walkInJudgingEndpoints WalkInJudgingEndpoint[]
  judgingTasks         JudgingTask[]

  @@map("judging_templates")
}

model JudgingTask {
  id                 String            @id @default(cuid())
  eventCompetitionId String
  judgingTemplateId  String
  routeSlug          String            @unique
  passcode           String
  label              String?
  status             JudgingTaskStatus @default(ACTIVE)
  createdAt          DateTime          @default(now())
  updatedAt          DateTime          @updatedAt

  eventCompetition EventCompetition @relation(fields: [eventCompetitionId], references: [id], onDelete: Cascade)
  judgingTemplate  JudgingTemplate  @relation(fields: [judgingTemplateId],  references: [id], onDelete: Cascade)
  scores           JudgingScore[]

  @@index([eventCompetitionId])
  @@map("judging_tasks")
}

model JudgingCriterion {
  id         String        @id @default(cuid())
  templateId String
  name       String
  order      Int           @default(0)
  type       CriterionType
  maxScore   Float?
  minScore   Float?
  maxTime    Int?          // seconds, for TIME type

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  template JudgingTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)
  options  JudgingOption[]
  scores   JudgingScore[]
  walkInJudgingScores WalkInJudgingScore[]

  @@index([templateId])
  @@map("judging_criterions")
}

model JudgingOption {
  id          String   @id @default(cuid())
  criterionId String
  label       String
  weight      Float    @default(0)
  order       Int      @default(0)

  criterion JudgingCriterion @relation(fields: [criterionId], references: [id], onDelete: Cascade)

  @@index([criterionId])
  @@map("judging_options")
}

model JudgingScore {
  id            String   @id @default(cuid())
  judgingTaskId String
  teamId        String
  criterionId   String
  score         Float?   // NUMBER / SINGLE_OPTION / MULTIPLE_OPTION
  timeSeconds   Int?     // TIME type
  optionIds     String[] // selected option ids (for display)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  judgingTask JudgingTask      @relation(fields: [judgingTaskId], references: [id], onDelete: Cascade)
  team        Team             @relation(fields: [teamId], references: [id], onDelete: Cascade)
  criterion   JudgingCriterion @relation(fields: [criterionId], references: [id], onDelete: Cascade)

  @@unique([judgingTaskId, teamId, criterionId])
  @@index([judgingTaskId])
  @@map("judging_scores")
}

// ─────────────────────────────────────────────────────────────────────────────
// RESULTS ENDPOINTS
// ─────────────────────────────────────────────────────────────────────────────

enum ResultsEndpointStatus {
  ACTIVE
  CLOSED
}

model ResultsEndpoint {
  id             String                @id @default(cuid())
  eventId        String
  routeSlug      String                @unique
  passcode       String?
  label          String?
  status         ResultsEndpointStatus @default(ACTIVE)
  isWalkIn       Boolean               @default(false)
  competitionIds String[]
  createdAt      DateTime              @default(now())
  updatedAt      DateTime              @updatedAt

  event Event @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@index([eventId])
  @@map("results_endpoints")
}

model AttendanceEndpoint {
  id        String    @id @default(cuid())
  eventId   String
  routeCode String    @unique
  passcode  String
  label     String?
  active    Boolean   @default(true)
  retiredAt DateTime?
  createdAt DateTime  @default(now())

  event Event @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@index([eventId])
  @@map("attendance_endpoints")
}

// ─────────────────────────────────────────────────────────────────────────────
// KNOWLEDGE BASE
// ─────────────────────────────────────────────────────────────────────────────

model KnowledgeBase {
  id         String   @id @default(cuid())
  path       String   @unique   // e.g. "events/zon-tengah"
  title      String
  content    String   @db.Text
  entityType String?            // "event" | "competition" | null = custom
  entityId   String?            // source entity id for auto-push
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([entityType, entityId])
  @@map("knowledge_base")
}

// ─────────────────────────────────────────────────────────────────────────────
// LANDING PAGE CONTENT
// ─────────────────────────────────────────────────────────────────────────────

model Gallery {
  id          String         @id @default(cuid())
  title       String
  year        Int
  description String?        @db.Text
  coverUrl    String?
  photos      GalleryPhoto[]
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  @@map("galleries")
}

model GalleryPhoto {
  id          String   @id @default(cuid())
  galleryId   String
  driveFileId String
  thumbUrl    String
  fullUrl     String
  description String?
  order       Int      @default(0)
  createdAt   DateTime @default(now())

  gallery Gallery @relation(fields: [galleryId], references: [id], onDelete: Cascade)

  @@index([galleryId])
  @@map("gallery_photos")
}

model NewsArticle {
  id          String    @id @default(cuid())
  title       String
  source      String?
  sourceUrl   String?
  content     String    @db.Text
  images      String[]  @default([])
  isPublished Boolean   @default(false)
  publishedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@map("news_articles")
}

model TeamEvent {
  id         String    @id @default(cuid())
  teamId     String
  eventId    String
  selected   Boolean   @default(false)
  acceptance String    @default("PENDING")
  attendedAt DateTime?
  createdAt  DateTime  @default(now())

  team  Team  @relation(fields: [teamId], references: [id], onDelete: Cascade)
  event Event @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@unique([teamId, eventId])
  @@map("team_events")
}

model Announcement {
  id          String    @id @default(cuid())
  title       String
  content     String    @db.Text
  coverUrl    String?
  isPublished Boolean   @default(false)
  publishedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@map("announcements")
}

// ─────────────────────────────────────────────────────────────────────────────
// THIRD-PARTY INTEGRATIONS
// ─────────────────────────────────────────────────────────────────────────────

model DroneAccess {
  id            String      @id @default(cuid())
  participantId String      @unique
  droneUserId   String
  dronePassword String
  createdAt     DateTime    @default(now())

  participant   Participant @relation(fields: [participantId], references: [id], onDelete: Cascade)

  @@map("drone_access")
}

model TeamDroneAccess {
  id            String   @id @default(cuid())
  teamId        String   @unique
  droneUserId   String
  dronePassword String
  createdAt     DateTime @default(now())

  team          Team     @relation(fields: [teamId], references: [id], onDelete: Cascade)

  @@map("team_drone_access")
}

model EmailBlast {
  id            String           @id @default(cuid())
  title         String
  subject       String?
  htmlBody      String?
  includeHeader Boolean          @default(true)
  includeFooter Boolean          @default(true)
  scheduledAt   DateTime?
  sentAt        DateTime?
  sentCount     Int              @default(0)
  status        EmailBlastStatus @default(DRAFT)
  createdById   String
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt

  createdBy  OrganizerUser        @relation(fields: [createdById], references: [id])
  recipients EmailBlastRecipient[]

  @@map("email_blasts")
}

model EmailBlastRecipient {
  id      String  @id @default(cuid())
  blastId String
  email   String
  name    String
  meta    String?
  status  String  @default("PENDING")
  sentAt  DateTime?

  blast EmailBlast @relation(fields: [blastId], references: [id], onDelete: Cascade)

  @@unique([blastId, email])
  @@map("email_blast_recipients")
}

enum EmailBlastStatus {
  DRAFT
  SCHEDULED
  IN_PROGRESS
  COMPLETED
}

model ContingentDistance {
  id           String   @id @default(cuid())
  eventId      String
  contingentId String
  schoolName   String
  stateName    String
  districtName String
  status       String   @default("PROCESSING")
  roadKm       Float?
  airKm        Float?
  waterKm      Float?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@unique([eventId, contingentId])
  @@map("contingent_distances")
}
