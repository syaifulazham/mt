// ─────────────────────────────────────────────────────────────────────────────
// THIRD-PARTY INTEGRATIONS
// ─────────────────────────────────────────────────────────────────────────────

/**
 * A participant's Eptim FC-1 (Viblock Arena) player account, created the same
 * way DroneAccess is: userid = IC digits, member of the contingent's sector.
 * The password is kept because /auth/token needs it; "__existing__" means the
 * account already existed upstream and its password is unknown here.
 */
model ParticipantFc1Access {
  id            String   @id @default(cuid())
  participantId String   @unique
  fc1UserId     String // the `userid` sent to FC-1 (IC digits)
  fc1Password   String
  createdAt     DateTime @default(now())

  participant Participant @relation(fields: [participantId], references: [id], onDelete: Cascade)

  @@map("participant_fc1_access")
}

/**
 * A participant's registration for one FC-1 challenge of one event-competition,
 * mirrored from FC-1's `challenge_registrations` (guide §4.5). Written only
 * after FC-1 accepted the registration; `fc1SyncedAt` records when it last
 * confirmed it. A null `fc1SyncedAt` means FC-1 was never told.
 */
model ParticipantFc1Challenge {
  id                 String    @id @default(cuid())
  participantId      String
  eventCompetitionId String
  challengeId        String
  challengeName      String
  fc1SyncedAt        DateTime?
  // Latest one-click launch link (POST /auth/launch): single-use, 5 minutes.
  // Kept so the dashboard can show it and ask FC-1 whether it is still valid.
  launchCode         String?
  launchUrl          String?
  launchExpiresAt    DateTime?
  createdAt          DateTime  @default(now())

  participant Participant @relation(fields: [participantId], references: [id], onDelete: Cascade)

