enum JudgingTaskStatus {
  ACTIVE
  CLOSED
}

enum CriterionType {
  NUMBER
  TIME
  SINGLE_OPTION
  MULTIPLE_OPTION
}

model JudgingTemplate {
  id          String   @id @default(cuid())
  name        String
  code        String   @unique
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  criterions             JudgingCriterion[]
  eventCompetitions      EventCompetitionJudgingTemplate[]
  walkInCompetitions     EventWalkInCompetitionJudgingTemplate[]
  walkInJudgingEndpoints WalkInJudgingEndpoint[]
  judgingTasks           JudgingTask[]

  @@map("judging_templates")
}

model JudgingTask {
  id                 String            @id @default(cuid())
  eventCompetitionId String
  judgingTemplateId  String
  routeSlug          String            @unique
  passcode           String
  label              String?
  status             JudgingTaskStatus @default(ACTIVE)
  // Set when the judge announces their task complete from the judging page —
  // locks the task's form. When every ACTIVE task of the competition is
  // complete, the competition's judgingStatus moves to COMPLETED on its own.
  completedAt        DateTime?
  createdAt          DateTime          @default(now())
  updatedAt          DateTime          @updatedAt

  eventCompetition EventCompetition @relation(fields: [eventCompetitionId], references: [id], onDelete: Cascade)
  judgingTemplate  JudgingTemplate  @relation(fields: [judgingTemplateId], references: [id], onDelete: Cascade)
  scores           JudgingScore[]

  @@index([eventCompetitionId])
  @@map("judging_tasks")
}

model JudgingCriterion {
  id            String        @id @default(cuid())
  templateId    String
  name          String
  order         Int           @default(0)
  type          CriterionType
  maxScore      Float?
  minScore      Float?
  maxTime       Float? // seconds, for TIME type (fractional when timePrecision > 0)
  /// TIME type: decimal places judges record — 0 = saat, 2 = 1/100 saat, 3 = milisaat.
  timePrecision Int           @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  template            JudgingTemplate      @relation(fields: [templateId], references: [id], onDelete: Cascade)
  options             JudgingOption[]
  scores              JudgingScore[]
  walkInJudgingScores WalkInJudgingScore[]

  @@index([templateId])
  @@map("judging_criterions")
}

model JudgingOption {
  id          String @id @default(cuid())
  criterionId String
  label       String
  weight      Float  @default(0)
  order       Int    @default(0)

  criterion JudgingCriterion @relation(fields: [criterionId], references: [id], onDelete: Cascade)

  @@index([criterionId])
  @@map("judging_options")
}

model JudgingScore {
  id            String   @id @default(cuid())
  judgingTaskId String
  teamId        String
  criterionId   String
  score         Float? // NUMBER / SINGLE_OPTION / MULTIPLE_OPTION
  timeSeconds   Float? // TIME type, seconds (fractional to the criterion's timePrecision)
  optionIds     String[] // selected option ids (for display)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  judgingTask JudgingTask      @relation(fields: [judgingTaskId], references: [id], onDelete: Cascade)
  team        Team             @relation(fields: [teamId], references: [id], onDelete: Cascade)
  criterion   JudgingCriterion @relation(fields: [criterionId], references: [id], onDelete: Cascade)

  @@unique([judgingTaskId, teamId, criterionId])
  @@index([judgingTaskId])
  @@map("judging_scores")
}

