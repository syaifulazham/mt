/// AI marking of one team's published WebCraft project against a judging
/// template (the rubric). status: IDLE | QUEUED | RUNNING | DONE | ERROR.
/// A re-run keeps the previous result until the new one replaces it.
/// "Rekod ke kad skor" copies DONE results into JudgingScore.
model WebcraftAiJudgement {
  id                 String    @id @default(cuid())
  eventCompetitionId String
  teamId             String
  status             String    @default("IDLE")
  templateId         String?
  projectId          String?
  projectName        String?
  projectUrl         String?
  /// [{ criterionId, name, score, max, reason }]
  scores             Json?
  total              Float?
  maxTotal           Float?
  comment            String?
  error              String?
  model              String?
  queuedAt           DateTime?
  startedAt          DateTime?
  judgedAt           DateTime?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  eventCompetition EventCompetition @relation(fields: [eventCompetitionId], references: [id], onDelete: Cascade)
  team             Team             @relation(fields: [teamId], references: [id], onDelete: Cascade)

  @@unique([eventCompetitionId, teamId])
  @@index([eventCompetitionId, status])
  @@map("webcraft_ai_judgements")
}

