// ─────────────────────────────────────────────────────────────────────────────
// CERTIFICATES
//
// ARCHIVAL CONTRACT — do not "normalise" this away:
// `certificates` has foreign keys to `seasons` and `cert_template_versions` and
// to NOTHING else. participantId / contingentId / teamId / eventId /
// competitionId are opaque strings with no referential integrity ON PURPOSE, so
// that purging a past season's participants, teams, contingents and events can
// neither cascade into certificates nor fail on a constraint. A certificate
// renders from its own snapshot columns plus its frozen template version.
// ─────────────────────────────────────────────────────────────────────────────

model Season {
  id           String    @id @default(cuid())
  code         String    @unique // "MT25", "MT26" — identity
  serialPrefix String // prefix printed in the serial; shared by a legacy season and its live counterpart
  year         Int
  name         String
  isCurrent    Boolean   @default(false) // exactly one true — partial unique index in the migration
  archivedAt   DateTime? // operational data absent/purged: render + lookup only, no issuing
  createdAt    DateTime  @default(now())

  templates      CertTemplate[]
  certificates   Certificate[]
  serialCounters CertSerialCounter[]

  @@index([year])
  @@map("seasons")
}

model CertTemplate {
  id               String             @id @default(cuid())
  seasonId         String
  name             String
  targetType       CertTargetType
  status           CertTemplateStatus @default(DRAFT)
  draftConfig      Json // edited freely; frozen into a version on publish
  baseAssetUrl     String? // draft base asset (R2)
  baseAssetType    CertAssetType?
  currentVersionId String?            @unique
  competitionId    String? // soft refs — optional narrowing only
  eventId          String?
  winnerRankFrom   Int?
  winnerRankTo     Int?
  prerequisites    Json? // phase 3
  createdBy        String
  updatedBy        String?
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt

  season         Season                @relation(fields: [seasonId], references: [id])
  versions       CertTemplateVersion[] @relation("TemplateVersions")
  currentVersion CertTemplateVersion?  @relation("CurrentVersion", fields: [currentVersionId], references: [id])

  @@index([seasonId, targetType])
  @@index([status])
  @@map("cert_templates")
}

model CertTemplateVersion {
  id            String        @id @default(cuid())
  templateId    String
  version       Int
  baseAssetUrl  String
  baseAssetType CertAssetType
  configuration Json // config v2 — see src/lib/certificates/config-schema.ts
  publishedAt   DateTime      @default(now())
  publishedBy   String?

  template     CertTemplate  @relation("TemplateVersions", fields: [templateId], references: [id], onDelete: Cascade)
  headOf       CertTemplate? @relation("CurrentVersion")
  certificates Certificate[]

  @@unique([templateId, version])
  @@map("cert_template_versions")
}

model Certificate {
  id                String @id @default(cuid())
  seasonId          String
  templateVersionId String

  serialNumber  String     @unique // MT25/GEN/000001 — printed, immutable
  uniqueCode    String     @unique // opaque token for public verification
  status        CertStatus @default(READY)
  issuedAt      DateTime?
  revokedAt     DateTime?
  revokedReason String?

  // Snapshot — everything the PDF needs, frozen at issue time
  recipientName   String
  recipientType   CertRecipientType
  recipientIc     String?
  recipientEmail  String?
  contingentName  String?
  schoolName      String?
  stateName       String?
  countryName     String?
  teamName        String?
  competitionName String?
  competitionCode String?
  eventName       String?
  awardTitle      String?
  rank            Int?
  meta            Json?

  // Soft references — plain columns, deliberately NOT relations (see contract above)
  participantId       String?
  contingentId        String?
  teamId              String?
  eventId             String?
  competitionId       String?
  legacyCertId        Int?    @unique // mt25 certificate.id — import idempotency key
  legacyParticipantId Int?
  legacyContingentId  Int?

  createdBy String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  season          Season              @relation(fields: [seasonId], references: [id])
  templateVersion CertTemplateVersion @relation(fields: [templateVersionId], references: [id])

  @@index([seasonId, status])
  @@index([participantId])
  @@index([contingentId])
  @@index([recipientIc])
  @@index([recipientName])
  @@index([templateVersionId])
  @@index([eventId, teamId])
  @@map("certificates")
}

/// Certificates → Generator: a job that issues certificate rows from a template
/// for a recipient source. `config` holds the source settings (event,
/// competitions, ranks, custom rows, event-name override). Runs in batches
/// driven by the page; re-running skips recipients already issued for the
/// template (certificates.meta.genKey).
model CertGeneratorJob {
  id          String    @id @default(cuid())
  templateId  String
  source      String // EVENT_PARTICIPANTS | EVENT_WINNERS | ALL_REGISTERED | CUSTOM
  config      Json      @default("{}")
  status      String    @default("DRAFT") // DRAFT | RUNNING | DONE | FAILED
  total       Int       @default(0)
  created     Int       @default(0)
  skipped     Int       @default(0)
  error       String?
  createdBy   String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  completedAt DateTime?

  @@index([templateId])
  @@map("cert_generator_jobs")
}

model CertSerialCounter {
  id           String   @id @default(cuid())
  seasonId     String
  typeCode     String   @db.VarChar(10)
  lastSequence Int      @default(0)
  updatedAt    DateTime @updatedAt

  season Season @relation(fields: [seasonId], references: [id])

  @@unique([seasonId, typeCode])
  @@map("cert_serial_counters")
}

enum CertTargetType {
  GENERAL
  EVENT_PARTICIPANT
  EVENT_WINNER
  NON_CONTEST_PARTICIPANT
  QUIZ_PARTICIPANT
  QUIZ_WINNER
  TRAINER
  CONTINGENT
  SCHOOL_WINNER
}

enum CertTemplateStatus {
  DRAFT
  ACTIVE
  ARCHIVED
}

enum CertAssetType {
  PDF
  IMAGE
}

enum CertStatus {
  DRAFT
  LISTED
  READY
  REVOKED
}

enum CertRecipientType {
  PARTICIPANT
  TRAINER
  CONTINGENT
  MANAGER
  OTHER
}

// ── Duel competitions (Robot Tempur, Robot Sumo…) ─────────────────────────────
// Teams are drawn into sessions; each session is ranked and the top ranks
// advance to the next round until a single final. Points per session:
// 1st = n, …, last = 1 (n = teams in the session). See src/lib/duel.ts.

model DuelRound {
  id                 String    @id @default(cuid())
  eventCompetitionId String
  // "" for a national bracket; the state id when the duel scope is STATE
  // (each state runs its own rounds and standings).
  groupKey           String    @default("")
  number             Int
  isFinal            Boolean   @default(false)
  status             String    @default("DRAFT") // DRAFT | CONFIRMED | DONE
  split              String    @default("even") // even | fill
  noSameContingent   Boolean   @default(false)
  noSameState        Boolean   @default(false)
  startAt            DateTime?
  confirmedAt        DateTime?
  confirmedBy        String?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  eventCompetition EventCompetition @relation(fields: [eventCompetitionId], references: [id], onDelete: Cascade)
  sessions         DuelSession[]

  @@unique([eventCompetitionId, groupKey, number])
  @@map("duel_rounds")
}

model DuelSession {
  id                String    @id @default(cuid())
  roundId           String
  number            Int
  label             String
  arena             Int       @default(1)
  wave              Int       @default(0)
  scheduledAt       DateTime?
  status            String    @default("PENDING") // PENDING | RUNNING | PAUSED | DONE
  startedAt         DateTime?
  pausedAt          DateTime?
  pausedMs          Int       @default(0)
  endedAt           DateTime?
  // Live video from the media team's phone (Cloudflare Stream, WebRTC). The
  // publish URL holds a secret: it only goes to the media endpoint.
  streamInputId     String?
  streamPublishUrl  String?
  streamPlaybackUrl String?
  streamHeartbeatAt DateTime? // the camera page pings while broadcasting
  // Replay recorded on the phone and uploaded to Cloudflare Stream.
  replayVideoId     String?
  replayStatus      String? // UPLOADING | READY | FAILED
  replayUrl         String? // Stream watch page
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  round   DuelRound   @relation(fields: [roundId], references: [id], onDelete: Cascade)
  entries DuelEntry[]

  @@index([roundId])
  @@map("duel_sessions")
}

model DuelEntry {
  id        String  @id @default(cuid())
  sessionId String
  teamId    String
  slot      Int     @default(0)
  rank      Int?
  points    Int?
  advanced  Boolean @default(false)

  session DuelSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  team    Team        @relation(fields: [teamId], references: [id], onDelete: Cascade)

  @@unique([sessionId, teamId])
  @@index([teamId])
  @@map("duel_entries")
}

model DuelDisplayEndpoint {
  id             String   @id @default(cuid())
  eventId        String
  routeSlug      String   @unique
  passcode       String?
  label          String?
  kind           String   @default("SCHEDULE") // SCHEDULE | LIVE
  competitionIds String[] // event competition ids; empty = every duel competition
  status         String   @default("ACTIVE") // ACTIVE | CLOSED
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  event Event @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@index([eventId])
  @@map("duel_display_endpoints")
}
