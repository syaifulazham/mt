generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─────────────────────────────────────────────────────────────────────────────
// ORGANIZER AUTH (Auth.js v5)
// ─────────────────────────────────────────────────────────────────────────────

model OrganizerUser {
  id                  String        @id @default(cuid())
  email               String        @unique
  name                String
  passwordHash        String
  role                OrganizerRole @default(VIEWER)
  totpSecretEnc       String?
  totpEnabled         Boolean       @default(false)
  forcePasswordChange Boolean       @default(false)
  isActive            Boolean       @default(true)
  inviteToken         String?       @unique
  inviteExpiresAt     DateTime?
  lastLoginAt         DateTime?
  createdById         String?
  createdAt           DateTime      @default(now())
  updatedAt           DateTime      @updatedAt
  deletedAt           DateTime?

  sessions    OrganizerSession[]
  accounts    OrganizerAccount[]
  emailBlasts EmailBlast[]

  @@map("organizer_users")
}

model OrganizerSession {
  id           String        @id @default(cuid())
  sessionToken String        @unique
  userId       String
  expires      DateTime
  user         OrganizerUser @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("organizer_sessions")
}

model OrganizerAccount {
  id                String        @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  user              OrganizerUser @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@map("organizer_accounts")
}

enum OrganizerRole {
  SUPER_ADMIN
  ADMIN
  OPERATOR
  PARTICIPANTS_MANAGER
  JUDGE_COORDINATOR
  VIEWER
}

// ─────────────────────────────────────────────────────────────────────────────
// MANAGER AUTH (Clerk-managed, synced via webhook)
// ─────────────────────────────────────────────────────────────────────────────

model ManagerProfile {
  id                  String           @id @default(cuid())
  clerkUserId         String           @unique
  email               String           @unique
  name                String
  phone               String?
  idType              IdType?
  idNumber            String?
  nationality         String?
  address             String?
  institutionType     InstitutionType?
  schoolId            String?
  higherInstitutionId String?
  countryId           String?
  profileComplete     Boolean          @default(false)
  lmsUserId           String?
  lmsPassword         String?
  createdAt           DateTime         @default(now())
  updatedAt           DateTime         @updatedAt
  deletedAt           DateTime?

  school             School?             @relation(fields: [schoolId], references: [id])
  higherInstitution  HigherInstitution?  @relation(fields: [higherInstitutionId], references: [id])
  country            Country?            @relation(fields: [countryId], references: [id])
  contingentManagers ContingentManager[]

  @@map("manager_profiles")
}

enum IdType {
  IC
  PASSPORT
}

enum InstitutionType {
  SCHOOL
  HIGHER
  INDEPENDENT
  INTERNATIONAL
}

// ─────────────────────────────────────────────────────────────────────────────
// REFERENCE DATA — Geography
// ─────────────────────────────────────────────────────────────────────────────

model Country {
  id       String  @id @default(cuid())
  name     String
  codeIso2 String  @unique @db.Char(2)
  codeIso3 String  @unique @db.Char(3)
  isActive Boolean @default(true)

  states      State[]
  managers    ManagerProfile[]
  contingents Contingent[]

  @@map("countries")
}

/// A frozen copy of the organizer dashboard (Overview, View by Zone, View by
/// State and every zone / state page), built part by part by a Super Admin.
/// `parts` maps a part key ("overview", "zones", "zone:<id>", "states",
/// "state:<id>") to the exact JSON the live endpoint returned.
model DashboardSnapshot {
  id          String    @id @default(cuid())
  label       String?
  status      String    @default("BUILDING") // BUILDING | READY | FAILED
  parts       Json      @default("{}")
  partCount   Int       @default(0)
  createdBy   String?
  createdAt   DateTime  @default(now())
  completedAt DateTime?

  @@map("dashboard_snapshots")
}

model AppSetting {
  key   String @id
  value String

  @@map("app_settings")
}

model State {
  id        String  @id @default(cuid())
  name      String
  code      String  @unique
  flagUrl   String?
  countryId String

  country            Country             @relation(fields: [countryId], references: [id])
  zoneStates         ZoneState[]
  schools            School[]
  higherInstitutions HigherInstitution[]
  contingents        Contingent[]
  events             Event[]

  @@map("states")
}

model Zone {
  id   String @id @default(cuid())
  name String

  states      ZoneState[]
  districts   District[]
  schools     School[]
  contingents Contingent[]
  events      Event[]

  @@map("zones")
}

model ZoneState {
  zoneId  String
  stateId String

  zone  Zone  @relation(fields: [zoneId], references: [id], onDelete: Cascade)
  state State @relation(fields: [stateId], references: [id], onDelete: Cascade)

  @@id([zoneId, stateId])
  @@map("zone_states")
}

model District {
  id     String @id @default(cuid())
  name   String
  zoneId String

  zone    Zone     @relation(fields: [zoneId], references: [id])
  schools School[]

  @@map("districts")
}

// ─────────────────────────────────────────────────────────────────────────────
// REFERENCE DATA — Institutions
// ─────────────────────────────────────────────────────────────────────────────

model School {
  id            String         @id @default(cuid())
  name          String
  code          String         @unique
  ppdCode       String?
  stateId       String
  zoneId        String?
  districtId    String?
  level         SchoolLevel
  category      SchoolCategory
  categoryShort String?
  isActive      Boolean        @default(true)
  latitude      Float?
  longitude     Float?

  state       State            @relation(fields: [stateId], references: [id])
  zone        Zone?            @relation(fields: [zoneId], references: [id])
  district    District?        @relation(fields: [districtId], references: [id])
  contingents Contingent[]
  managers    ManagerProfile[]

  @@map("schools")
}

model HigherInstitution {
  id         String  @id @default(cuid())
  name       String
  code       String? @unique
  stateId    String?
  isActive   Boolean @default(true)
  heiType    String  @default("HQ") // HQ or BRANCH
  parentCode String? // for BRANCH: code of the parent HQ
  sector     String? // PUBLIC, PRIVATE, FOREIGN_BRANCH

  state       State?           @relation(fields: [stateId], references: [id])
  contingents Contingent[]
  managers    ManagerProfile[]

  @@map("higher_institutions")
}

enum SchoolLevel {
  PRIMARY
  SECONDARY
  SPECIAL
}

enum SchoolCategory {
  // ── Public national schools ───────────────────────────────────────────────
  SEKOLAH_KEBANGSAAN             @map("Sekolah Kebangsaan")
  SEKOLAH_MENENGAH_KEBANGSAAN    @map("Sekolah Menengah Kebangsaan")
  SEKOLAH_JENIS_KEBANGSAAN_CINA  @map("Sekolah Jenis Kebangsaan Cina")
  SEKOLAH_JENIS_KEBANGSAAN_TAMIL @map("Sekolah Jenis Kebangsaan Tamil")

  // ── Religious schools ─────────────────────────────────────────────────────
  SEKOLAH_MENENGAH_KEBANGSAAN_AGAMA       @map("Sekolah Menengah Kebangsaan Agama")
  SEKOLAH_MENENGAH_AGAMA_BANTUAN_KERAJAAN @map("Sekolah Menengah Agama Bantuan Kerajaan")
  SEKOLAH_RENDAH_AGAMA_BANTUAN_KERAJAAN   @map("Sekolah Rendah Agama Bantuan Kerajaan")
  SEKOLAH_MENENGAH_AGAMA                  @map("Sekolah Menengah Agama")
  SEKOLAH_RENDAH_AGAMA                    @map("Sekolah Rendah Agama")
  SEKOLAH_KEBANGSAAN_TAHFIZ               @map("Sekolah Kebangsaan Tahfiz")

  // ── Elite / residential ───────────────────────────────────────────────────
  SEKOLAH_BERASRAMA_PENUH  @map("Sekolah Berasrama Penuh")
  MAKTAB_RENDAH_SAINS_MARA @map("Maktab Rendah Sains MARA")

  // ── Vocational & technical ────────────────────────────────────────────────
  KOLEJ_VOKASIONAL        @map("Kolej Vokasional")
  SEKOLAH_MENENGAH_TEKNIK @map("Sekolah Menengah Teknik")

  // ── Special needs ─────────────────────────────────────────────────────────
  SEKOLAH_KEBANGSAAN_PENDIDIKAN_KHAS @map("Sekolah Kebangsaan Pendidikan Khas")
  SEKOLAH_MENENGAH_PENDIDIKAN_KHAS   @map("Sekolah Menengah Pendidikan Khas")
  SEKOLAH_BIMBINGAN_JALINAN_KASIH    @map("Sekolah Bimbingan Jalinan Kasih")
  SEKOLAH_MODEL_KHAS                 @map("Sekolah Model Khas")

  // ── Specialised public schools ────────────────────────────────────────────
  SEKOLAH_SENI_MALAYSIA  @map("Sekolah Seni Malaysia")
  SEKOLAH_SUKAN_MALAYSIA @map("Sekolah Sukan Malaysia")
  PUSAT_TINGKATAN_ENAM   @map("Pusat Tingkatan Enam")
  KOLEJ_TINGKATAN_ENAM   @map("Kolej Tingkatan Enam")

  // ── Private & independent ─────────────────────────────────────────────────
  SEKOLAH_ANTARABANGSA               @map("Sekolah Antarabangsa")
  SEKOLAH_MENENGAH_PERSENDIRIAN_CINA @map("Sekolah Menengah Persendirian Cina")
  SEKOLAH_MENENGAH_AKADEMIK          @map("Sekolah Menengah Akademik")
  SEKOLAH_RENDAH_AKADEMIK            @map("Sekolah Rendah Akademik")
}

// ─────────────────────────────────────────────────────────────────────────────
// CONTINGENTS (Phase 1 — structure only, full relations in Phase 2)
// ─────────────────────────────────────────────────────────────────────────────

model Contingent {
  id                  String           @id @default(cuid())
  name                String
  shortName           String?
  logoUrl             String?
  contingentType      ContingentType
  locality            Locality?
  schoolId            String?
  higherInstitutionId String?
  countryInvitationId String?
  stateId             String?
  zoneId              String?
  countryId           String?
  status              ContingentStatus @default(ACTIVE)
  createdAt           DateTime         @default(now())
  updatedAt           DateTime         @updatedAt

  school              School?              @relation(fields: [schoolId], references: [id])
  higherInstitution   HigherInstitution?   @relation(fields: [higherInstitutionId], references: [id])
  state               State?               @relation(fields: [stateId], references: [id])
  zone                Zone?                @relation(fields: [zoneId], references: [id])
  country             Country?             @relation(fields: [countryId], references: [id])
  managers            ContingentManager[]
  participants        Participant[]
  teams               Team[]
  trainers            Trainer[]
  walkInRegistrations WalkInRegistration[]

  @@unique([schoolId])
  @@map("contingents")
}

model ContingentManager {
  id             String                  @id @default(cuid())
  contingentId   String
  managerId      String
  role           ContingentManagerRole   @default(MANAGER)
  status         ContingentManagerStatus @default(ACTIVE)
  requestMessage String?
  respondedAt    DateTime?
  createdAt      DateTime                @default(now())

  contingent Contingent     @relation(fields: [contingentId], references: [id], onDelete: Cascade)
  manager    ManagerProfile @relation(fields: [managerId], references: [id])

  @@unique([contingentId, managerId])
  @@map("contingent_managers")
}

enum Locality {
  BANDAR
  SUB_BANDAR
  LUAR_BANDAR
  PEDALAMAN_1
  PEDALAMAN_2
  PEDALAMAN_3
}

enum ContingentType {
  SCHOOL
  HIGHER
  INDEPENDENT
  INTERNATIONAL
}

enum ContingentStatus {
  ACTIVE
  SUSPENDED
}

enum ContingentManagerRole {
  OWNER
  MANAGER
}

enum ContingentManagerStatus {
  PENDING
  ACTIVE
  REJECTED
}

// ─────────────────────────────────────────────────────────────────────────────
// CONTESTANTS
// ─────────────────────────────────────────────────────────────────────────────

model Participant {
  id           String     @id @default(cuid())
  name         String
  ic           String?
  /// Foreign participants (INTERNATIONAL contingent with a non-MY country) have
  /// a passport instead of an IC; birthDate then stands in for the IC-derived age.
  passport     String?
  birthDate    DateTime?  @db.Date
  email        String?
  phoneNumber  String?
  gender       Gender
  age          Int?
  eduLevel     EduLevel
  classGrade   String?
  className    String?
  ethnicity    Ethnicity?
  status       String     @default("ACTIVE")
  ppki         Boolean    @default(false)
  passwordHash String?
  contingentId String
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  contingent            Contingent                       @relation(fields: [contingentId], references: [id], onDelete: Cascade)
  teamMembers           TeamMember[]
  sessions              ParticipantSession[]
  competitionAttendance TeamEventParticipantAttendance[]
  droneAccesses         DroneAccess[]
  webcraftAccess        ParticipantWebcraftAccess?
  walkInRegistrations   WalkInRegistration[]
  walkInFormSubmissions WalkInFormSubmission[]
  quizzlyAccess         ParticipantQuizzlyAccess?
  quizzlyTokens         ParticipantQuizzlyToken[]
  fc1Access             ParticipantFc1Access?
  fc1Challenges         ParticipantFc1Challenge[]
  droneChallenges       ParticipantDroneChallenge[]

  @@index([contingentId])
  @@map("contestants")
}

/**
 * Proof that this participant exists in Asia Spark Quizzly. Quizzly has no
 * "look up by personal_id" endpoint, so registration state has to be recorded
 * here; `personalId` is what was sent (the IC), and creation is idempotent
 * upstream via ?upsert=true.
 */
model ParticipantQuizzlyAccess {
  id                   String   @id @default(cuid())
  participantId        String   @unique
  quizzlyParticipantId String
  personalId           String
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  participant Participant @relation(fields: [participantId], references: [id], onDelete: Cascade)

  @@map("participant_quizzly_access")
}

/**
 * The most recent login token issued to a participant for one event-competition.
 * Quizzly tokens are single-use 6-digit codes, so re-issuing replaces the row —
 * the previous code is dead the moment it is redeemed anyway.
 */
model ParticipantQuizzlyToken {
  id                 String    @id @default(cuid())
  participantId      String
  eventCompetitionId String
  quizId             String
  quizTitle          String?
  tokenId            String
  token              String
  startUrl           String?
  expiresAt          DateTime?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  participant Participant @relation(fields: [participantId], references: [id], onDelete: Cascade)

  @@unique([participantId, eventCompetitionId])
  @@index([participantId])
  @@map("participant_quizzly_tokens")
}

model ParticipantSession {
  id            String   @id @default(cuid())
  participantId String
  token         String   @unique @default(cuid())
  expiresAt     DateTime
  createdAt     DateTime @default(now())

  participant Participant @relation(fields: [participantId], references: [id], onDelete: Cascade)

  @@index([participantId])
  @@map("participant_sessions")
}

enum Ethnicity {
  MELAYU
  CINA
  INDIA
  ORANG_ASLI_SEMENANJUNG
  BUMIPUTRA_SABAH
  BUMIPUTRA_SARAWAK
  LAIN_LAIN
}

enum Gender {
  MALE
  FEMALE
}

enum EduLevel {
  KINDERGARTEN
  PRIMARY
  SECONDARY
  YOUTH
}

// ─────────────────────────────────────────────────────────────────────────────
// TARGET GROUPS & THEMES
// ─────────────────────────────────────────────────────────────────────────────

model TargetGroup {
  id          String   @id @default(cuid())
  code        String   @unique
  name        String
  schoolLevel String
  ageGroup    String
  minAge      Int      @default(0)
  maxAge      Int      @default(0)
  classGrades String[] @default([])
  ppki        Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  competitions CompetitionTargetGroup[]

  @@map("target_groups")
}

model Theme {
  id          String   @id @default(cuid())
  name        String   @unique
  color       String?
  logoUrl     String?
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  competitions Competition[]

  @@map("themes")
}

// ─────────────────────────────────────────────────────────────────────────────
// EVENTS & COMPETITIONS
// ─────────────────────────────────────────────────────────────────────────────

enum ParticipationPolicy {
  ALL
  PREREQUISITE_SELECTED
  ALL_EXCEPT_ZONE_WINNERS
}

model Event {
  id                         String              @id @default(cuid())
  name                       String
  slug                       String              @unique
  description                String?
  scope                      EventScope          @default(NATIONAL)
  stateId                    String?
  zoneId                     String?
  venue                      String?
  address                    String?
  city                       String?
  latitude                   Float?
  longitude                  Float?
  startDate                  DateTime?
  endDate                    DateTime?
  registrationStart          DateTime?
  registrationEnd            DateTime?
  status                     EventStatus         @default(DRAFT)
  needManagerAcceptance      Boolean             @default(false)
  walkInUniqueParticipation  Boolean             @default(false)
  // Pre-registered path: may one participant enter several competitions of this
  // event? false = "Penyertaan Tunggal Sahaja" (the long-standing rule).
  allowMultipleParticipation Boolean             @default(false)
  participationPolicy        ParticipationPolicy @default(ALL)
  winnerExclusionRank        Int?
  /// Penghakiman → Tetapan global: how tied teams affect the next rank.
  /// SKIP = 1, 2, 2, 4 · DENSE = 1, 2, 2, 3. Used by scoreboard, keputusan,
  /// pengumuman, medal tally and certificate generation.
  sharedRankMode             String              @default("SKIP")
  createdAt                  DateTime            @default(now())
  updatedAt                  DateTime            @updatedAt

  state                  State?                   @relation(fields: [stateId], references: [id])
  zone                   Zone?                    @relation(fields: [zoneId], references: [id])
  prerequisites          EventPrerequisite[]      @relation("EventPrerequisites")
  asPrerequisiteOf       EventPrerequisite[]      @relation("EventAsPrerequisite")
  eventCompetitions      EventCompetition[]
  walkInCompetitions     EventWalkInCompetition[]
  walkInEndpoints        WalkInEndpoint[]
  mediaEndpoints         MediaEndpoint[]
  walkInFormEndpoints    WalkInFormEndpoint[]
  walkInJudgingEndpoints WalkInJudgingEndpoint[]
  teamEvents             TeamEvent[]
  resultsEndpoints       ResultsEndpoint[]
  duelDisplayEndpoints   DuelDisplayEndpoint[]
  medalTallyEndpoints    MedalTallyEndpoint[]
  announcementEndpoints  AnnouncementEndpoint[]
  announcementEntries    AnnouncementEntry[]
  /// How many places the MC boards announce per result (5 = ranks 1–5).
  announcementMaxPlaces  Int                      @default(3)
  attendanceEndpoints    AttendanceEndpoint[]

  @@map("events")
}

model EventPrerequisite {
  eventId        String
  prerequisiteId String

  event        Event @relation("EventPrerequisites", fields: [eventId], references: [id], onDelete: Cascade)
  prerequisite Event @relation("EventAsPrerequisite", fields: [prerequisiteId], references: [id], onDelete: Cascade)

  @@id([eventId, prerequisiteId])
  @@map("event_prerequisites")
}

model Competition {
  id                           String            @id @default(cuid())
  code                         String            @unique
  name                         String
  description                  String?
  themeId                      String?
  participationType            ParticipationType @default(INDIVIDUAL)
  minTeamSize                  Int               @default(1)
  maxTeamSize                  Int               @default(1)
  maxParticipantsPerContingent Int               @default(0)
  maxTotalParticipants         Int               @default(0)
  venue                        String?
  address                      String?
  startDate                    DateTime?
  endDate                      DateTime?
  registrationStart            DateTime?
  registrationEnd              DateTime?
  judgingType                  JudgingType       @default(PERCENTAGE)
  eptimEduCourseId             String?
  eptimEduCourseTitle          String?
  thirdPartyIntegration        String?           @default("none")
  /// Counted in the dashboard's initial participation stats (eligibility pass).
  includeInDashboardStats      Boolean           @default(true)
  createdAt                    DateTime          @default(now())
  updatedAt                    DateTime          @updatedAt

  theme              Theme?                   @relation(fields: [themeId], references: [id])
  targetGroups       CompetitionTargetGroup[]
  judgingCriteria    JudgingCriteria[]
  eventCompetitions  EventCompetition[]
  walkInCompetitions EventWalkInCompetition[]
  teams              Team[]
  docs               CompetitionDoc[]

  @@map("competitions")
}

model CompetitionDoc {
  id            String   @id @default(cuid())
  competitionId String
  name          String
  url           String
  key           String
  size          Int?
  uploadedAt    DateTime @default(now())

  competition Competition @relation(fields: [competitionId], references: [id], onDelete: Cascade)

  @@index([competitionId])
  @@map("competition_docs")
}

model EventCompetition {
  id                      String    @id @default(cuid())
  eventId                 String
  competitionId           String
  picName                 String?
  picContact              String?
  maxTeams                Int       @default(0)
  eptimEduCourseId        String?
  eptimEduCourseTitle     String?
  eptimCsiCompetitionId   String?
  eptimCsiCompetitionName String?
  eptimCsiCases           Json? // [{ id, slug, title }] — cases picked from the CSI competition
  quizzlySessionId        String?
  quizzlySessionTitle     String?
  quizzlyAssignBy         String? // "target_group" | "grade" — how quizzes are matched to participants
  quizzlyQuizMap          Json? // [{ targetGroupId, targetGroupName, grade, quizId, quizTitle }] — grade is null in target_group mode
  fc1EventId              String? // Viblock event the picks came from — EPTIMFC1_API_KEY decides it, so a rotated key is detectable
  fc1Challenges           Json? // [{ id, name, challenge_mode, status }] — challenges picked from the Eptim FC-1 event
  droneEventId            String? // Eptim Drone event the picks came from — EPTIMDRONE_API_KEY decides it
  droneChallenges         Json? // [{ id, name, challenge_mode, status }] — challenges picked from the Eptim Drone event
  // Judging lifecycle: OPEN → COMPLETED (announced complete; judge forms locked)
  // → VERIFIED (results confirmed by a Super Admin). Only a Super Admin reopens.
  judgingStatus           String    @default("OPEN")
  judgingCompletedAt      DateTime?
  judgingCompletedBy      String?
  judgingVerifiedAt       DateTime?
  judgingVerifiedBy       String?
  // "SCORE" (judging templates) or "DUEL" (drawn sessions ranked round by round, src/lib/duel.ts)
  judgingMethod           String    @default("SCORE")
  duelConfig              Json? // { perSession, advance, arenas, durationSec, breakSec }
  // Results ranked "NATIONAL" (one list) or "STATE" (per state); null = event scope default (src/lib/resultScope.ts)
  resultScope             String?
  // Judging setup (method, templates, duel config, result scope) frozen while set
  configLockedAt          DateTime?
  configLockedBy          String?
  createdAt               DateTime  @default(now())
  updatedAt               DateTime  @updatedAt

  event                Event                             @relation(fields: [eventId], references: [id], onDelete: Cascade)
  competition          Competition                       @relation(fields: [competitionId], references: [id], onDelete: Cascade)
  judgingTemplates     EventCompetitionJudgingTemplate[]
  judgingTasks         JudgingTask[]
  duelRounds           DuelRound[]
  webcraftAiJudgements WebcraftAiJudgement[]

  @@unique([eventId, competitionId])
  @@map("event_competitions")
}

model EventWalkInCompetition {
  id                         String    @id @default(cuid())
  eventId                    String
  competitionId              String
  picName                    String?
  picContact                 String?
  maxSlots                   Int       @default(0)
  publishToPortal            Boolean   @default(false)
  useViblockarena            Boolean   @default(false)
  useDronearena              Boolean   @default(false)
  useVibeblocks              Boolean   @default(false)
  viblockChallengeId         String?
  vibeBlocksChallengeId      String?
  vibeBlocksEventName        String?
  vibeBlocksStartsAt         DateTime?
  vibeBlocksEndsAt           DateTime?
  vibeBlocksRunDurationSec   Int?
  vibeBlocksCompetitionRound String?
  /// VibeBlocks event school level: "primary" | "secondary" (null = legacy event, or TechTriathlon).
  vibeBlocksSchoolLevel      String?
  /// Game platform behind the vibeBlocks* fields: "vibeblocks" or "techtriathlon"
  /// (same partner-API shape; see src/lib/vibeblocks.ts).
  vibeBlocksProvider         String    @default("vibeblocks")
  viblockChallengeLocked     Boolean   @default(false)
  judgingTemplatesLocked     Boolean   @default(false)
  walkInSlotSchedule         Json?
  // Judging lifecycle, as on EventCompetition: OPEN → COMPLETED (forms locked)
  // → VERIFIED (Super Admin). Only a Super Admin reopens.
  judgingStatus              String    @default("OPEN")
  judgingCompletedAt         DateTime?
  judgingCompletedBy         String?
  judgingVerifiedAt          DateTime?
  judgingVerifiedBy          String?
  createdAt                  DateTime  @default(now())
  updatedAt                  DateTime  @updatedAt

  event            Event                                   @relation(fields: [eventId], references: [id], onDelete: Cascade)
  competition      Competition                             @relation(fields: [competitionId], references: [id])
  registrations    WalkInRegistration[]
  endpoints        WalkInEndpoint[]
  formSubmissions  WalkInFormSubmission[]
  judgingTemplates EventWalkInCompetitionJudgingTemplate[]
  judgingEndpoints WalkInJudgingEndpoint[]

  @@unique([eventId, competitionId])
