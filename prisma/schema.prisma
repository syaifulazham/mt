}

enum WalkInFormSubmissionStatus {
  PENDING
  PROCESSED
  NO_MATCH
}

model WalkInFormSubmission {
  id                   String                     @id @default(cuid())
  /// The public borang it came from; null when submitted from the participant
  /// portal dashboard.
  endpointId           String?
  walkInCompetitionId  String
  ic                   String
  name                 String
  schoolName           String?
  /// "YYYY-MM-DD" (MYT) the slot is on for multi-day events; "" otherwise.
  slotDate             String                     @default("")
  sessionNumber        Int?
  slotNumber           Int?
  status               WalkInFormSubmissionStatus @default(PENDING)
  participantId        String?
  walkInRegistrationId String?
  /// TEAM competitions: the temporary team from the borang. `ic`/`name` hold
  /// the first member; teamMembers is [{ name, ic }] for all members, in order.
  teamName             String?
  teamMembers          Json?
  /// The main-data team this entry was verified into (set when processed).
  teamId               String?
  processedAt          DateTime?
  createdAt            DateTime                   @default(now())
  updatedAt            DateTime                   @updatedAt

  endpoint           WalkInFormEndpoint?    @relation(fields: [endpointId], references: [id], onDelete: Cascade)
  walkInCompetition  EventWalkInCompetition @relation(fields: [walkInCompetitionId], references: [id], onDelete: Cascade)
  participant        Participant?           @relation(fields: [participantId], references: [id])
  walkInRegistration WalkInRegistration?    @relation(fields: [walkInRegistrationId], references: [id])
  team               Team?                  @relation(fields: [teamId], references: [id], onDelete: SetNull)

  @@index([endpointId, status])
  @@index([ic])
  @@map("walkin_form_submissions")
}

enum WalkInJudgingEndpointStatus {
  ACTIVE
  CLOSED
}

model WalkInJudgingEndpoint {
  id                  String                      @id @default(cuid())
